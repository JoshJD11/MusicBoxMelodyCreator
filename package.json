{
  "name": "music-box-melody-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "predeploy": "npm run lint && npm run test:coverage && npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@blueprintjs/core": "^3.24.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "three": "0.130.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^9.5.0",
    "@types/node": "^22.20.5",
    "@types/react": "^16.9.25",
    "@types/react-dom": "^16.9.5",
    "@types/three": "^0.130.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "sass": "^1.108.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
